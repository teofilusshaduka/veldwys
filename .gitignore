# Secrets — never commit
.env

# Python
.venv/
__pycache__/
*.py[cod]

# Local data (regenerate: prepare_real_data.py, seed_demo.py)
data/veldwys.db
data/uploads/
data/real_sites.csv
data/real_grazing.csv

# Raw dataset media (3.4 GB of site photos + reference material, not read by the code).
# The field forms the pipeline actually parses are committed.
archive/pictures/
archive/supportive_material/

# Presentation build output (6 MB; rebuild: python create_presentation.py)
Indaba_Presentation.pptx

# Stitch design mockups (2.5 MB of exported UI comps, not built by the app)
stitch_veld_command/

# Loose copies of the notebook photos — the tests read
# tests/fixtures/notebook/ instead, which holds the same four files.
tests/*.jpg

# Local tooling
.claude/
.idea/

# OS
.DS_Store
